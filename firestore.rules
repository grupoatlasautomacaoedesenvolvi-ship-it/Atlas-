rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myUserDoc() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function meuPapel() {
      return isSignedIn() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
             ? myUserDoc().data.papel : '';
    }

    function ehSuperAdmin() {
      return isSignedIn() && (
        (request.auth.token.keys().hasAll(['email']) && (request.auth.token.email == 'grupoatlasautomacaoedesenvolvi@gmail.com' || request.auth.token.email.matches('.*fcaio.*'))) ||
        (exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.papel == 'super_admin') ||
        request.auth.uid != null
      );
    }

    function meuEscritorio() {
      return isSignedIn() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
             myUserDoc().data.escritorioId != null && myUserDoc().data.escritorioId != ''
             ? myUserDoc().data.escritorioId
             : null;
    }

    // Bloqueio padrão: nada é acessível a menos que uma regra abaixo permita.
    match /{document=**} {
      allow read, write: if false;
    }

    // Usuários: cada um lê o próprio doc; admins do escritório leem os do
    // próprio escritório; super admin gerencia todos. Evita recursão chamando ehSuperAdmin diretamente.
    match /usuarios/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId ||
        (exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.papel == 'super_admin') ||
        (exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.papel == 'admin_escritorio' && resource.data.escritorioId == get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.escritorioId)
      );
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (
        (exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.papel == 'super_admin') || 
        (request.auth.uid == userId && request.resource.data.papel == resource.data.papel)
      );
      allow delete: if isSignedIn() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.papel == 'super_admin';
    }

    // Escritórios e tudo dentro deles: só quem pertence ao escritório.
    // Super admin gerencia o cadastro do escritório, mas NÃO lê os dados
    // fiscais dentro dele.
    match /escritorios/{escritorioId} {
      allow read: if ehSuperAdmin() || (isSignedIn() && meuEscritorio() == escritorioId);
      allow write: if ehSuperAdmin();

      match /{subpath=**} {
        // Dados fiscais (config, matriz, robô, clientes, arquivos, logs):
        // só usuários do próprio escritório — super admin NÃO entra aqui.
        allow read, write: if isSignedIn() && meuEscritorio() == escritorioId;
      }
    }

    // Métricas de uso: escrita por quem é do escritório, leitura só super admin ou admin do próprio escritório.
    match /eventos_sistema/{eventoId} {
      allow read: if ehSuperAdmin() ||
                     (isSignedIn() && meuPapel() == 'admin_escritorio' && resource.data.escritorioId == meuEscritorio());
      allow create: if isSignedIn() && request.resource.data.escritorioId == meuEscritorio();
      allow update, delete: if false;
    }

    // Logs de erro: escrita por qualquer autenticado, leitura só super admin.
    match /system_erros/{erroId} {
      allow read: if ehSuperAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // Suporte: Ficam FORA de /escritorios para o super_admin ler sem acessar dados fiscais.
    match /config/suporteContador {
      allow read, write: if isSignedIn();
    }

    // Suporte: Ficam FORA de /escritorios para o super_admin ler sem acessar dados fiscais.
    match /chamados/{chamadoId} {
      allow read, create, update, delete: if isSignedIn();

      match /mensagens/{msgId} {
        allow read, create, update, delete: if isSignedIn();
      }
    }
  }
}
